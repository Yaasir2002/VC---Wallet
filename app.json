{
  "expo": {
    "name": "VC Wallet",
    "slug": "vc-wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vcwallet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yaasir.vcwallet",
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikasi membutuhkan kamera untuk memindai QR Verifiable Credential dan Verifiable Presentation.",
        "NSFaceIDUsageDescription": "Aplikasi menggunakan autentikasi biometrik untuk melindungi akses private key dan credential sensitif."
      }
    },
    "android": {
      "package": "com.yaasir.vcwallet",
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikasi membutuhkan kamera untuk memindai QR Verifiable Credential dan Verifiable Presentation."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Aplikasi menggunakan autentikasi biometrik untuk melindungi akses private key dan credential sensitif."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9def4eac-db82-4418-9b68-d989efa49227"
      }
    }
  }
}
